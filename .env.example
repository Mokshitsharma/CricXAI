# Copy to .env and fill in. .env is gitignored (docs/RULES.md R-38).

# --- API data / model locations (default to ./data/* if unset) ---
CRICXAI_MODEL_DIR=data/models
CRICXAI_PROCESSED_DIR=data/processed

# --- Phase 3+ platform (not required for the mock slice) ---
DATABASE_URL=postgresql+psycopg://cricxai:cricxai@localhost:5432/cricxai
REDIS_URL=redis://localhost:6379/0
OBJECT_STORE_BUCKET=
OBJECT_STORE_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Phase 5 auth / billing ---
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Scraper (Phase 2) ---
# Fill real ESPNcricinfo series IDs in scripts/match_ids.py TOURNAMENTS.
CRICXAI_SCRAPE_BATCH_SIZE=10
